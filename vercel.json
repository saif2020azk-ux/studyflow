{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.py": {
      "excludeFiles": "{tests/**,docs/**,test-data/local-results.json,**/__pycache__/**}"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index?__path=/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/api/index?__path=/:path*"
    }
  ]
}
